@page
@model HelloWorldSSO.Pages.Admin.Sso.SamlModel
@{ ViewData["Title"] = "SAML SSO Setup"; }
<h1>SAML SSO Setup</h1>
<p>Service Provider Entity ID: <code>@Model.BaseUrl/Saml2</code></p>
<p>Assertion Consumer Service URL: <code>@Model.BaseUrl/Saml2/Acs</code></p>
<p>Service Provider Metadata: <a href="@Model.BaseUrl/Saml2">Download Metadata</a></p>
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }
<form method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label class="form-label">Identity Provider Metadata (XML file)</label>
        <input type="file" name="MetadataFile" class="form-control" accept=".xml" />
    </div>
    <p>OR</p>
    <div class="mb-3">
        <label asp-for="MetadataUrl" class="form-label">Metadata URL (https only)</label>
        <input asp-for="MetadataUrl" class="form-control" />
    </div>
    <button class="btn btn-primary">Validate &amp; Save Configuration</button>
    <a class="btn btn-link" asp-page="Index">Back</a>
</form>
<p class="mt-3 text-muted">After saving, return to the SSO page to run Test Login and then Activate SSO.</p>
