@model HelloWorldSSO.Services.SsoOperationResult?
@if (Model is not null)
{
    @foreach (var error in Model.Errors)
    {
        <div class="alert alert-danger small mb-2">@error</div>
    }
    @foreach (var warning in Model.Warnings)
    {
        <div class="alert alert-warning small mb-2">@warning</div>
    }
}
@if (ViewContext.TempData["Message"] is string message)
{
    <div class="alert alert-success small mb-2">@message</div>
}
@if (ViewContext.TempData["Warning"] is string warn)
{
    <div class="alert alert-warning small mb-2">@warn</div>
}
